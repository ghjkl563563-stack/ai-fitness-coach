# 環境變數範本 —— 複製為 .env 並填入自己的值。
# .env 已列在 .gitignore 中，不會進版控；這個範本不可填入任何真實金鑰。

# ── AI 教練講評 (必要，未設定則講評功能停用) ─────────────
# 取得位置：https://aistudio.google.com/apikey
GEMINI_API_KEY=
BLE_HR_ADDRESS=

# ── 熱量估算用的受試者資料 (選填) ──────────────────────
# 供 Keytel (2005) 心率-能量消耗迴歸式使用
USER_WEIGHT_KG=65
USER_AGE=22
USER_SEX=M          # M 或 F


# ──────────────────────────────────────────────────────
# 設定方式
#
# PowerShell (僅本次工作階段)
#     $env:GEMINI_API_KEY = "你的金鑰"
#
# PowerShell (永久，需重開終端機才生效)
#     setx GEMINI_API_KEY "你的金鑰"
#
# CMD
#     set GEMINI_API_KEY=你的金鑰
#
# 若想直接讀取這個 .env 檔，可自行安裝 python-dotenv 並在程式進入點加上：
#     from dotenv import load_dotenv; load_dotenv()
# ──────────────────────────────────────────────────────
